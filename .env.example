# Environment variables for Concrete Knowledge Graph Application
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Configuration (OpenAI or compatible API)
# =============================================================================
OPENAI_API_KEY=your-openai-api-key-here
# Optional: Custom base URL for local LLM servers (Ollama, LM Studio, etc.)
# OPENAI_API_BASE=http://localhost:11434/v1
# Model to use for extraction
LLM_MODEL=gpt-4o-mini

# =============================================================================
# Neo4j AuraDB Configuration
# =============================================================================
# Get these from your Neo4j AuraDB instance dashboard
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password-here

# =============================================================================
# Application Settings
# =============================================================================
# Enable demo mode by default (works without API keys)
DEMO_MODE=true
